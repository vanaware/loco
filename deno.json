{
  "tasks": {
    "build": "deno run --allow-read --allow-write build.ts",
    "start": "deno task build && deno run --allow-read --allow-net main.ts",
    "dev": "deno task build && deno run --allow-read --allow-net --watch main.ts",
    "test": "deno test --allow-env --allow-net tests/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    "preact": "https://esm.sh/preact@10.19.3",
    "preact/hooks": "https://esm.sh/preact@10.19.3/hooks",
    "preact/jsx-runtime": "https://esm.sh/preact@10.19.3/jsx-runtime",
    "@preact/signals": "https://esm.sh/@preact/signals@1.2.2",
    "@libs/qrcode": "jsr:@libs/qrcode@^1",
    "fflate": "https://esm.sh/fflate@0.8.2",
    "@material/web": "https://esm.sh/@material/web@1.5.1?bundle",
    "idb-keyval": "https://esm.sh/idb-keyval@6.2.1",
    "@libs/web-push": "jsr:@libs/web-push@^0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["dom", "dom.iterable", "es2022", "webworker"]
  }
}
